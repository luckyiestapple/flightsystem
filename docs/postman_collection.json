  "item": [
    {
      "name": "3. Input data (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"{{airlineCode}}\",\n  \"airline_name\": \"Airline Uji Coba\",\n  \"country\": \"Indonesia\",\n  \"contact\": \"+62-21-555-0100\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/flights/airlines"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const guid = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
              "const airlineCode = 'T' + guid.substring(0, 9);",
              "pm.collectionVariables.set('airlineCode', airlineCode);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Response sukses sesuai envelope', function () { pm.expect(body.status).to.eql(201); pm.expect(body.message).to.eql('Data berhasil ditambahkan.'); pm.expect(body.data).to.be.an('object'); });",
              "pm.test('ID airline berhasil dibuat', function () { pm.expect(body.data.airline_id).to.be.a('string'); });",
              "pm.collectionVariables.set('airlineId', body.data.airline_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Ambil semua data (GET collection)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"

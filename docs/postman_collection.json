          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response collection sesuai envelope', function () { pm.expect(body.status).to.eql(200); pm.expect(body.message).to.eql('Data berhasil diambil.'); pm.expect(body.data).to.be.an('array'); });",
              "pm.test('Collection memuat record yang baru dibuat', function () { pm.expect(body.data.some(function (item) { return item.airline_id === pm.collectionVariables.get('airlineId'); })).to.eql(true); });"
            ]
          }
        }
      ]

{
  "info": {
    "_postman_id": "bd5eaf6f-e472-43f7-9f21-e0e74a4d70b8",
    "name": "Flight API - CRUD Smoke Test",
    "description": "Uji coba CRUD airlines. Jalankan seluruh request secara berurutan di Collection Runner. Request pertama membuat data dan menyimpan airlineId untuk request selanjutnya. Base URL default: http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "airlineId",
      "value": ""
    },
    {
      "key": "airlineCode",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "item": [
    {
      "name": "3. Input data (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"{{airlineCode}}\",\n  \"airline_name\": \"Airline Uji Coba\",\n  \"country\": \"Indonesia\",\n  \"contact\": \"+62-21-555-0100\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/flights/airlines"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const airlineCode = 'T' + Date.now().toString().slice(-9);",
              "pm.collectionVariables.set('airlineCode', airlineCode);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Response memakai envelope standar', function () { pm.expect(Object.keys(body).sort()).to.eql(['data', 'message', 'status']); pm.expect(body.status).to.eql('success'); pm.expect(body.message).to.eql(null); });",
              "pm.test('ID airline berhasil dibuat', function () { pm.expect(body.data.airline_id).to.be.a('string'); });",
              "pm.collectionVariables.set('airlineId', body.data.airline_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Ambil semua data (GET collection)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/airlines"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response collection memakai envelope standar', function () { pm.expect(Object.keys(body).sort()).to.eql(['data', 'message', 'status']); pm.expect(body.status).to.eql('success'); pm.expect(body.message).to.eql(null); pm.expect(body.data).to.be.an('array'); });",
              "pm.test('Collection memuat record yang baru dibuat', function () { pm.expect(body.data.some(function (item) { return item.airline_id === pm.collectionVariables.get('airlineId'); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Ambil detail data (GET by ID)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/airlines/{{airlineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Detail memakai envelope standar dan ID yang benar', function () { pm.expect(Object.keys(body).sort()).to.eql(['data', 'message', 'status']); pm.expect(body.status).to.eql('success'); pm.expect(body.message).to.eql(null); pm.expect(body.data.airline_id).to.eql(pm.collectionVariables.get('airlineId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Ambil data yang tidak ada (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/airlines/{{missingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404 Not Found', function () { pm.response.to.have.status(404); });",
              "const body = pm.response.json();",
              "pm.test('Error memakai envelope standar', function () { pm.expect(Object.keys(body).sort()).to.eql(['data', 'message', 'status']); pm.expect(body.status).to.eql('error'); pm.expect(body.data).to.eql(null); pm.expect(body.message).to.eql('Data tidak ditemukan.'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Edit data lengkap (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"{{airlineCode}}\",\n  \"airline_name\": \"Airline Uji Coba Diperbarui\",\n  \"country\": \"Indonesia\",\n  \"contact\": \"+62-21-555-0101\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/flights/airlines/{{airlineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('PUT berhasil memperbarui record', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.data.airline_name).to.eql('Airline Uji Coba Diperbarui'); pm.expect(body.message).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update sebagian (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country\": \"Indonesia - Uji PATCH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/flights/airlines/{{airlineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('PATCH hanya mengubah field yang dikirim', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.data.country).to.eql('Indonesia - Uji PATCH'); pm.expect(body.data.airline_name).to.eql('Airline Uji Coba Diperbarui'); pm.expect(body.message).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Tampilkan data yang dicari",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/search/airlines?q={{airlineCode}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Hasil pencarian memuat airline uji coba', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.message).to.eql(null); pm.expect(body.data).to.be.an('array'); pm.expect(body.data.some(function (item) { return item.airline_code === pm.collectionVariables.get('airlineCode'); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Delete data (200)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/airlines/{{airlineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Delete berhasil dan record dihapus', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.data).to.eql(null); pm.expect(body.message).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Delete ulang untuk memastikan data sudah terhapus (404)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights/airlines/{{airlineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404 Not Found: record sudah tidak ada', function () { pm.response.to.have.status(404); });",
              "const body = pm.response.json();",
              "pm.test('API memastikan record sudah terhapus', function () { pm.expect(body.status).to.eql('error'); pm.expect(body.data).to.eql(null); pm.expect(body.message).to.eql('Data tidak ditemukan.'); });"
            ]
          }
        }
      ]
    }
  ]
}

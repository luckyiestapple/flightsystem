{
  "info": {
    "_postman_id": "bd5eaf6f-e472-43f7-9f21-e0e74a4d70b8",
    "name": "Flight API - CRUD Manual Tests",
    "description": "Manual requests for the Flight API. Import the Flight Local environment and set base_url to app.baseURL from the PHP .env file (without the trailing slash). Set place_id, pilot_id, and record IDs before using detail requests. DELETE requests permanently remove local records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET semua data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/airlines"
      }
    },
    {
      "name": "2. GET dengan pencarian",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/search/airlines?q=GA"
      }
    },
    {
      "name": "3. GET detail berdasarkan ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/airlines/{{airline_id}}"
      }
    },
    {
      "name": "4. POST tambah data",
      "request": {
        "method": "POST",
        "description": "Contoh sukses. Jika TST001 sudah ada, ganti airline_code dengan kode baru sebelum mengirim.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"TST001\",\n  \"airline_name\": \"Airline Uji Coba\",\n  \"country\": \"Indonesia\",\n  \"contact\": \"+62-21-555-0100\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines"
      }
    },
    {
      "name": "5. POST data tidak valid - kode GA sudah digunakan (400)",
      "request": {
        "method": "POST",
        "description": "Prasyarat: kode GA sudah dipakai record di database. Diharapkan HTTP 400 dengan messages.airline_code bernilai: Kode GA sudah digunakan.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"GA\",\n  \"airline_name\": \"Kode Duplikat\",\n  \"country\": \"Indonesia\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines"
      }
    },
    {
      "name": "6. PUT ubah seluruh data",
      "request": {
        "method": "PUT",
        "description": "Ganti {{airline_id}} dengan ID dari respons POST tambah data. Gunakan airline_code yang sama dengan record tersebut.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"TST001\",\n  \"airline_name\": \"Airline Uji Coba Diperbarui\",\n  \"country\": \"Indonesia\",\n  \"contact\": \"+62-21-555-0101\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines/{{airline_id}}"
      }
    },
    {
      "name": "7. PATCH ubah sebagian kolom",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country\": \"Indonesia - PATCH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines/{{airline_id}}"
      }
    },
    {
      "name": "Fixture - POST record untuk uji PUT duplikat",
      "request": {
        "method": "POST",
        "description": "Kirim request ini lalu salin data.airline_id dari respons ke URL request PUT konflik dan cleanup. Jika FX901 sudah terpakai, ganti airline_code.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"FX901\",\n  \"airline_name\": \"Fixture Uji Konflik\",\n  \"country\": \"Indonesia\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines"
      }
    },
    {
      "name": "8. PUT dengan kode GA milik record lain (400)",
      "request": {
        "method": "PUT",
        "description": "Prasyarat: kode GA sudah dipakai record lain. Jalankan POST fixture, salin airline_id responsnya ke URL request ini. Diharapkan HTTP 400 dengan messages.airline_code bernilai: Kode GA sudah digunakan.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airline_code\": \"GA\",\n  \"airline_name\": \"Fixture Uji Konflik\",\n  \"country\": \"Indonesia\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/airlines/REPLACE_WITH_FIXTURE_AIRLINE_ID"
      }
    },
    {
      "name": "Cleanup - DELETE fixture konflik",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/airlines/REPLACE_WITH_FIXTURE_AIRLINE_ID"
      }
    },
    {
      "name": "9. DELETE hapus data",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/airlines/{{airline_id}}"
      }
    },
    {
      "name": "10. GET data yang sudah dihapus - 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/airlines/{{airline_id}}"
      }
    },
    {
      "name": "11a. POST tanpa body - 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"

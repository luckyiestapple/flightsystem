        "url": "{{base_url}}/api/airlines"
      }
    },
    {
      "name": "Place & Pilot API Proxy",
      "item": [
        {
          "name": "GET semua Place",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/place/"
          }
        },
        {
          "name": "GET detail Place",
          "request": {
            "method": "GET",
            "description": "Set the place_id environment variable to an ID returned by the Place API.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/places/{{place_id}}"
          }
        },
        {
          "name": "GET semua Pilot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pilots"
          }
        },
        {
          "name": "GET detail Pilot",
          "request": {
            "method": "GET",
            "description": "Set the pilot_id environment variable to an ID returned by the Pilot API.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pilots/{{pilot_id}}"
          }
        },
        {
          "name": "GET Flights dengan detail Place & Pilot",
          "request": {
            "method": "GET",
            "description": "Each flight response includes Place and Pilot detail when the saved external IDs are present and the upstream APIs are configured in the Flight server .env.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/flights"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "airline_id",
      "value": "REPLACE_WITH_AIRLINE_ID",
      "type": "string"
    },
    {
      "key": "place_id",
      "value": "REPLACE_WITH_PLACE_ID",
      "type": "string"
    },
    {
      "key": "pilot_id",
      "value": "REPLACE_WITH_PILOT_ID",
      "type": "string"
    }
  ]
}
